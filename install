#!/usr/bin/env bash
# Symlinks this repo's Herdr app config into ~/.config/herdr-app (or
# $HERDR_APP_HOME): keys.json, settings.json, each theme and layout file, and
# each mod folder. Only these are linked; Herdr's shipped files and its own
# state stay where they are. Safe to rerun: existing links are replaced, and a
# real file or folder in the way is moved into a per-run backup folder,
# $APP_HOME/.herdr-config-backup/<time>-<pid>/ (outside mods/, so Herdr never
# loads a backed-up mod), never overwritten or deleted.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_HOME="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
BACKUP_DIR="$APP_HOME/.herdr-config-backup/$(date +%Y%m%d-%H%M%S)-$$"

link() {
  local target=$1 link=$2
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then
    rm "$link"
  elif [ -e "$link" ]; then
    local backup="$BACKUP_DIR/${link#"$APP_HOME"/}"
    mkdir -p "$(dirname "$backup")"
    mv -n "$link" "$backup"
    if [ -e "$link" ]; then
      echo "not linked, could not move aside: $link" >&2
      return 1
    fi
    echo "moved aside: $link -> $backup"
  fi
  ln -s "$target" "$link"
  echo "linked: $link -> $target"
}

for file in keys.json settings.json; do
  link "$REPO/$file" "$APP_HOME/$file"
done

for dir in themes layouts; do
  for file in "$REPO/$dir"/*.json; do
    [ -e "$file" ] || continue
    link "$file" "$APP_HOME/$dir/$(basename "$file")"
  done
done

for mod in "$REPO"/mods/*/; do
  [ -d "$mod" ] || continue
  mod="${mod%/}"
  link "$mod" "$APP_HOME/mods/$(basename "$mod")"
done
