#!/usr/bin/env bash
# Symlinks this repo's Herdr app config into ~/.config/herdr-app (or
# $HERDR_APP_HOME): keys.json, settings.json, each theme and layout file, and
# each mod folder. Only these are linked; Herdr's shipped files and its own
# state stay where they are. Safe to rerun: existing links are replaced, and a
# real file in the way is moved aside, never overwritten.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_HOME="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
STAMP="$(date +%Y%m%d-%H%M%S)"

link() {
  local target=$1 link=$2
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then
    rm "$link"
  elif [ -e "$link" ]; then
    mv "$link" "$link.bak-$STAMP"
    echo "moved aside: $link -> $link.bak-$STAMP"
  fi
  ln -s "$target" "$link"
  echo "linked: $link -> $target"
}

for file in keys.json settings.json; do
  link "$REPO/$file" "$APP_HOME/$file"
done

for dir in themes layouts; do
  for file in "$REPO/$dir"/*.json; do
    [ -e "$file" ] && link "$file" "$APP_HOME/$dir/$(basename "$file")"
  done
done

for mod in "$REPO"/mods/*/; do
  mod="${mod%/}"
  link "$mod" "$APP_HOME/mods/$(basename "$mod")"
done
