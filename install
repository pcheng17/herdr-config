#!/usr/bin/env bash
# Symlinks this repo's Herdr app config into ~/.config/herdr-app (or
# $HERDR_APP_HOME): keys.json, settings.json, sessionizer.json, each theme and
# layout file, and each mod folder. Only these are linked; Herdr's shipped
# files and its own state stay where they are. Safe to rerun: existing links
# are replaced, and a real file or folder in the way is moved into a per-run
# backup folder, $APP_HOME/.herdr-config-backup/<time>-<pid>/ (outside mods/,
# so Herdr never loads a backed-up mod), never overwritten or deleted.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_HOME="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
BACKUP_DIR="$APP_HOME/.herdr-config-backup/$(date +%Y%m%d-%H%M%S)-$$"

# Same tags and colors as ~/.dotfiles/helper/log.sh.
log_ok() { printf "\033[32m[OK]\033[0m   %s\n" "$1"; }
log_info() { printf "\033[34m[INFO]\033[0m %s\n" "$1"; }
log_warn() { printf "\033[33m[WARN]\033[0m %s\n" "$1"; }
log_error() { printf "\033[31m[ERROR]\033[0m %s\n" "$1" >&2; }

# A path for messages: $HOME shown as ~. The links themselves use full paths.
pretty() {
  case "$1" in
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

link() {
  local target=$1 link=$2
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then
    rm "$link"
  elif [ -e "$link" ]; then
    local backup="$BACKUP_DIR/${link#"$APP_HOME"/}"
    mkdir -p "$(dirname "$backup")"
    mv -n "$link" "$backup"
    if [ -e "$link" ]; then
      log_error "Could not move aside, not linked: $(pretty "$link")"
      return 1
    fi
    log_warn "Moved aside $(pretty "$link") -> $(pretty "$backup")"
  fi
  ln -s "$target" "$link"
  log_ok "Symlink $(pretty "$link") -> $(pretty "$target")"
}

log_info "Symlinking Herdr app configs into $(pretty "$APP_HOME")..."

for file in keys.json settings.json sessionizer.json; do
  link "$REPO/$file" "$APP_HOME/$file"
done

log_info "Symlinking themes and layouts..."
for dir in themes layouts; do
  for file in "$REPO/$dir"/*.json; do
    [ -e "$file" ] || continue
    link "$file" "$APP_HOME/$dir/$(basename "$file")"
  done
done

log_info "Symlinking mods..."
for mod in "$REPO"/mods/*/; do
  [ -d "$mod" ] || continue
  mod="${mod%/}"
  link "$mod" "$APP_HOME/mods/$(basename "$mod")"
done

# macOS font smoothing draws text heavier than other terminals do; turn it off
# for Herdr only. Read at launch, so restart Herdr after the first install.
if [ "$(uname -s)" = Darwin ]; then
  log_info "Turning off macOS font smoothing for Herdr..."
  defaults write dev.herdr.app AppleFontSmoothing -int 0
  log_ok "Set dev.herdr.app AppleFontSmoothing = 0"
fi
